PORT=3000
HOST=127.0.0.1
NODE_ENV=production
TRUST_PROXY=1
JWT_SECRET=replace-with-a-long-random-secret
DATA_DIR=/www/wwwroot/automatic-assistant-data
ADMIN_USERNAME=admin
ADMIN_NAME=系统管理员
ADMIN_PASSWORD=replace-with-at-least-12-characters
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# 可在管理端“邮件投递”页面配置；也可以首次启动时从环境变量初始化
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Automatic Assistant
